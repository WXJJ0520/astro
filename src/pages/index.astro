---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { AUTHOR_NAME, GITHUB_URL, SITE_DESCRIPTION, SITE_TITLE, X_URL } from '../consts';
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<section class="hero card hero-card">
				<p class="eyebrow">AI · Crypto · Meme · Web3</p>
				<h1>{SITE_TITLE}</h1>
				<p class="lead">
					你好，我是 <strong>{AUTHOR_NAME}</strong>。这里主要写 AI、Crypto、Meme、Web3，记录我的观察、研究、实战、折腾和复盘。
				</p>
				<div class="cta-row">
					<a class="primary" href="/blog">查看文章</a>
					<a class="secondary" href="/about">关于我</a>
				</div>
				<div class="meta-row">
					<span>AI</span>
					<span>Crypto</span>
					<span>Meme</span>
					<span>Web3</span>
				</div>
			</section>

			<section class="stats">
				<div class="card stat">
					<div class="stat-label">关注方向</div>
					<div class="stat-value">AI / Crypto / Meme / Web3</div>
				</div>
				<div class="card stat">
					<div class="stat-label">内容类型</div>
					<div class="stat-value">研究、实战、复盘、笔记</div>
				</div>
				<div class="card stat">
					<div class="stat-label">更新方式</div>
					<div class="stat-value">持续写作，持续迭代</div>
				</div>
			</section>

			<section class="grid">
				<article class="card">
					<h2>写作方向</h2>
					<ul>
						<li>AI 工具、工作流与自动化</li>
						<li>Crypto / Web3 研究与实战观察</li>
						<li>Meme 市场、热点、策略与复盘</li>
						<li>项目搭建、部署、脚本和效率流</li>
					</ul>
				</article>
				<article class="card">
					<h2>链接</h2>
					<div class="links">
						<a href={GITHUB_URL} target="_blank" rel="noreferrer">GitHub</a>
						<a href={X_URL} target="_blank" rel="noreferrer">X / Twitter</a>
						<a href="/rss.xml">RSS</a>
					</div>
				</article>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.hero-card {
		padding: 3.5rem 1.6rem;
		background:
			radial-gradient(circle at top right, rgba(124, 92, 255, 0.18), transparent 28%),
			rgba(255, 255, 255, 0.03);
	}
	.eyebrow {
		text-transform: uppercase;
		letter-spacing: 0.2em;
		font-size: 0.78rem;
		color: rgb(var(--gray));
		margin-bottom: 1rem;
	}
	.lead {
		font-size: 1.15rem;
		max-width: 760px;
		color: rgb(var(--gray-light));
	}
	.cta-row {
		display: flex;
		gap: 1rem;
		margin-top: 1.5rem;
		flex-wrap: wrap;
	}
	.cta-row a {
		text-decoration: none;
		padding: 0.85rem 1.2rem;
		border-radius: 999px;
		font-weight: 700;
	}
	.primary {
		background: var(--accent);
		color: white;
	}
	.secondary {
		border: 1px solid rgba(var(--gray-light), 0.18);
		color: rgb(var(--gray-light));
	}
	.meta-row {
		display: flex;
		gap: 0.75rem;
		flex-wrap: wrap;
		margin-top: 1.25rem;
	}
	.meta-row span {
		padding: 0.45rem 0.8rem;
		border-radius: 999px;
		background: rgba(255, 255, 255, 0.05);
		border: 1px solid rgba(var(--gray-light), 0.08);
		font-size: 0.92rem;
		color: rgb(var(--gray-light));
	}
	.stats {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 1rem;
		margin: 1.2rem 0 2rem;
	}
	.stat-label {
		font-size: 0.9rem;
		color: rgb(var(--gray));
		margin-bottom: 0.35rem;
	}
	.stat-value {
		font-size: 1.02rem;
		font-weight: 700;
		color: white;
	}
	.grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1rem;
		margin: 1rem 0;
	}
	.card {
		background: rgba(255, 255, 255, 0.03);
		border: 1px solid rgba(var(--gray-light), 0.08);
		border-radius: 18px;
		padding: 1.35rem;
		box-shadow: 0 10px 30px rgba(0, 0, 0, 0.12);
	}
	.card h2 {
		font-size: 1.2rem;
		margin-bottom: 0.8rem;
	}
	.card ul {
		padding-left: 1.2rem;
		margin: 0.75rem 0 0;
	}
	.links {
		display: flex;
		flex-wrap: wrap;
		gap: 0.8rem;
	}
	.links a {
		text-decoration: none;
		padding: 0.7rem 1rem;
		border-radius: 12px;
		background: rgba(255, 255, 255, 0.04);
		border: 1px solid rgba(var(--gray-light), 0.08);
		color: rgb(var(--gray-light));
	}
	.links a:hover {
		border-color: rgba(124, 92, 255, 0.5);
		color: white;
	}
	@media (max-width: 820px) {
		.stats {
			grid-template-columns: 1fr;
		}
		.grid {
			grid-template-columns: 1fr;
		}
		.hero-card {
			padding: 2.4rem 1.2rem;
		}
	}
</style>
