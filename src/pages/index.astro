---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { AUTHOR_NAME, SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<section class="hero">
				<p class="eyebrow">AI · Code · Notes</p>
				<h1>{SITE_TITLE}</h1>
				<p class="lead">记录 AI、编程与折腾。一个偏技术的个人博客，后续会放项目笔记、踩坑总结和一些实战文章。</p>
				<div class="cta-row">
					<a class="primary" href="/blog">进入博客</a>
					<a class="secondary" href="/about">关于我</a>
				</div>
			</section>

			<section class="grid">
				<article class="card">
					<h2>现在有啥</h2>
					<ul>
						<li>Astro 技术博客骨架</li>
						<li>博客列表与文章详情页</li>
						<li>RSS 与 sitemap</li>
						<li>Cloudflare Pages 可直接部署</li>
					</ul>
				</article>
				<article class="card">
					<h2>下一步准备写</h2>
					<ul>
						<li>AI 工具使用记录</li>
						<li>项目搭建与部署笔记</li>
						<li>有用但容易忘的技术备忘录</li>
					</ul>
				</article>
			</section>

			<section class="card intro">
				<h2>站点说明</h2>
				<p>
					这个站默认是深色极简风，面向技术内容。后面你只需要继续往
					<code>src/content/blog/</code>
					里加 Markdown 文章，push 到 GitHub，Cloudflare Pages 就会自动更新。
				</p>
				<p>作者：{AUTHOR_NAME}</p>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.hero {
		padding: 4rem 0 2.5rem;
	}
	.eyebrow {
		text-transform: uppercase;
		letter-spacing: 0.2em;
		font-size: 0.78rem;
		color: rgb(var(--gray));
		margin-bottom: 1rem;
	}
	.lead {
		font-size: 1.15rem;
		max-width: 720px;
		color: rgb(var(--gray-light));
	}
	.cta-row {
		display: flex;
		gap: 1rem;
		margin-top: 1.5rem;
		flex-wrap: wrap;
	}
	.cta-row a {
		text-decoration: none;
		padding: 0.85rem 1.2rem;
		border-radius: 999px;
		font-weight: 700;
	}
	.primary {
		background: var(--accent);
		color: white;
	}
	.secondary {
		border: 1px solid rgba(var(--gray-light), 0.18);
		color: rgb(var(--gray-light));
	}
	.grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1rem;
		margin: 2rem 0;
	}
	.card {
		background: rgba(255, 255, 255, 0.03);
		border: 1px solid rgba(var(--gray-light), 0.08);
		border-radius: 18px;
		padding: 1.35rem;
		box-shadow: 0 10px 30px rgba(0, 0, 0, 0.12);
	}
	.card h2 {
		font-size: 1.2rem;
	}
	.card ul {
		padding-left: 1.2rem;
		margin: 0.75rem 0 0;
	}
	.intro {
		margin-bottom: 2rem;
	}
	@media (max-width: 720px) {
		.grid {
			grid-template-columns: 1fr;
		}
		.hero {
			padding-top: 2rem;
		}
	}
</style>
