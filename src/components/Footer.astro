---
import { AUTHOR_NAME, GITHUB_URL, X_URL } from '../consts';
const today = new Date();
---

<footer>
	<div class="footer-inner">
		<p>© {today.getFullYear()} {AUTHOR_NAME}. Built with Astro and hosted on Cloudflare Pages.</p>
		<p>
			<a href="/rss.xml">RSS</a>
			<span>·</span>
			<a href={X_URL} target="_blank" rel="noreferrer">X</a>
			<span>·</span>
			<a href={GITHUB_URL} target="_blank" rel="noreferrer">GitHub</a>
		</p>
	</div>
</footer>
<style>
	footer {
		padding: 2.5rem 1rem 4rem;
		border-top: 1px solid rgba(var(--gray-light), 0.12);
		color: rgb(var(--gray));
	}
	.footer-inner {
		max-width: 1100px;
		margin: 0 auto;
		text-align: center;
	}
	footer p {
		margin: 0.35rem 0;
	}
	footer a {
		color: rgb(var(--gray-light));
		text-decoration: none;
	}
	footer a:hover {
		color: white;
	}
	span {
		margin: 0 0.5rem;
	}
</style>
